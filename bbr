        echo -e "${CYAN}"
        echo "  ╔══════════════════════════════════════╗"
        echo "  ║       Linux 服务器一键优化工具       ║"
        echo "  ║    DNS · BBR · Swap · 网络加速       ║"
        echo "  ║              v1.5.3                  ║"
        echo "  ╚══════════════════════════════════════╝"
        echo -e "${NC}"
 
        show_sysinfo
 
        echo -e "  ${GREEN}1.${NC} 设置 DNS"
        echo -e "  ${GREEN}2.${NC} 开启 BBR TCP 拥塞控制"
        echo -e "  ${GREEN}3.${NC} 配置虚拟内存 (Swap)"
        echo -e "  ${GREEN}4.${NC} 一键全部执行"
        echo -e "  ${GREEN}5.${NC} 同步更新脚本"
        echo -e "  ${RED}6.${NC} 退出"
        echo ""
        echo -ne "  ${CYAN}请选择 [1-6]:${NC} "
        read -r choice
 
        case "$choice" in
            1) setup_dns ;;
            2) setup_bbr ;;
            3) setup_swap ;;
            4)
                setup_dns
                setup_bbr
                setup_swap
                echo ""
                success "全部优化已完成！"
                ;;
            5) self_update ;;
            6)
                echo ""
                info "感谢使用，再见！"
                exit 0
                ;;
            *)
                warn "无效选择，请输入 1-6"
                ;;
        esac
 
        echo ""
        echo -ne "  ${YELLOW}按 Enter 返回菜单...${NC}"
        read -r
    done
}
 
