#!/usr/bin/env bash
# ============================================================
# Linux 服务器一键优化脚本
# 功能：DNS 设置 / BBR TCP / 虚拟内存(Swap)
# 版本：v1.2.0
# ============================================================

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
PURPLE='\033[0;35m'
NC='\033[0m'

# 工具函数
info()    { echo -e "${GREEN}  ✓${NC}  $1"; }
warn()    { echo -e "${YELLOW}  ⚠${NC}  $1"; }
error()   { echo -e "${RED}  ✗${NC}  $1"; }
title()   { echo -e "\n${BLUE}┌─${NC} ${CYAN}$1${NC}"; echo -e "${BLUE}└────────────────────────────────${NC}"; }
success() { echo -e "${GREEN}  ✅ $1${NC}"; }
step()    { echo -e "${PURPLE}  →${NC}  $1"; }

# ============================================================
# 检查 root 权限
# ============================================================
check_root() {
    if [[ $EUID -ne 0 ]]; then
        error "请使用 root 权限运行此脚本"
        echo -e "    ${YELLOW}sudo bash optimize.sh${NC}"
        exit 1
    fi
}

# ============================================================
# 检测操作系统
# ============================================================
detect_os() {
    if [[ -f /etc/os-release ]]; then
        source /etc/os-release
        OS_ID="${ID,,}"
        OS_VERSION="${VERSION_ID}"
    elif [[ -f /etc/redhat-release ]]; then
        OS_ID="centos"
    else
        OS_ID="unknown"
    fi

    case "$OS_ID" in
        ubuntu|debian|linuxmint)
            PKG_MGR="apt"
            ;;
        centos|rhel|rocky|almalinux|fedora)
            if command -v dnf &>/dev/null; then
                PKG_MGR="dnf"
            else
                PKG_MGR="yum"
            fi
            ;;
        *)
            PKG_MGR="unknown"
            ;;
    esac
}

# ============================================================
# 备份文件（带时间戳）
# ============================================================
backup_file() {
    local file="$1"
    if [[ -f "$file" ]]; then
        local bak="${file}.bak.$(date +%Y%m%d%H%M%S)"
        cp "$file" "$bak"
        step "已备份: $file → $bak"
    fi
}

# ============================================================
# 模块 1：DNS 设置
# ============================================================
setup_dns() {
    while true; do
        # 读取当前 DNS
        local current_dns
        current_dns=$(grep "^nameserver" /etc/resolv.conf 2>/dev/null || echo "  (无法读取)")

        echo ""
        echo -e "  ${CYAN}优化DNS地址${NC}"
        echo -e "  ${BLUE}------------------------${NC}"
        echo -e "  ${YELLOW}当前DNS地址${NC}"
        echo "$current_dns" | while read -r line; do
            echo -e "  ${GREEN}$line${NC}"
        done
        echo -e "  ${BLUE}------------------------${NC}"
        echo ""
        echo -e "  ${GREEN}1.${NC} 国外DNS优化:"
        echo -e "     v4: ${CYAN}1.1.1.1  8.8.8.8${NC}"
        echo -e "     v6: ${CYAN}2606:4700:4700::1111  2001:4860:4860::8888${NC}"
        echo -e "  ${GREEN}2.${NC} 国内DNS优化:"
        echo -e "     v4: ${CYAN}223.5.5.5  183.60.83.19${NC}"
        echo -e "     v6: ${CYAN}2400:3200::1  2400:da00::6666${NC}"
        echo -e "  ${GREEN}3.${NC} 手动编辑DNS配置"
        echo -e "  ${BLUE}------------------------${NC}"
        echo -e "  ${RED}0.${NC} 返回上一级选单"
        echo -e "  ${BLUE}------------------------${NC}"
        echo -ne "  请输入你的选择: "
        read -r dns_choice

        case "$dns_choice" in
            1)
                _apply_dns "1.1.1.1" "8.8.8.8" "2606:4700:4700::1111" "2001:4860:4860::8888"
                ;;
            2)
                _apply_dns "223.5.5.5" "183.60.83.19" "2400:3200::1" "2400:da00::6666"
                ;;
            3)
                step "打开 /etc/resolv.conf 手动编辑..."
                # 先解锁
                chattr -i /etc/resolv.conf 2>/dev/null || true
                ${EDITOR:-vi} /etc/resolv.conf
                info "编辑完成"
                ;;
            0)
                return 0
                ;;
            *)
                warn "无效选择，请输入 0-3"
                ;;
        esac

        echo ""
        echo -ne "  ${YELLOW}按 Enter 继续...${NC}"
        read -r
    done
}

# 应用 DNS 配置
_apply_dns() {
    local v4_1="$1" v4_2="$2" v6_1="$3" v6_2="$4"

    step "正在应用 DNS 设置..."

    if systemctl is-active --quiet systemd-resolved 2>/dev/null; then
        backup_file "/etc/systemd/resolved.conf"
        cat > /etc/systemd/resolved.conf <<EOF
[Resolve]
DNS=${v4_1} ${v4_2} ${v6_1} ${v6_2}
FallbackDNS=8.8.8.8 8.8.4.4
DNSSEC=no
DNSOverTLS=no
Cache=yes
EOF
        systemctl restart systemd-resolved
        if [[ ! -L /etc/resolv.conf ]]; then
            backup_file "/etc/resolv.conf"
            ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
        fi
        info "systemd-resolved DNS 设置完成"

    elif systemctl is-active --quiet NetworkManager 2>/dev/null; then
        local conn
        conn=$(nmcli -t -f NAME,DEVICE,STATE con show --active | grep -v "lo" | head -1 | cut -d: -f1)
        if [[ -n "$conn" ]]; then
            nmcli con mod "$conn" ipv4.dns "${v4_1},${v4_2}" 2>/dev/null || true
            nmcli con mod "$conn" ipv6.dns "${v6_1},${v6_2}" 2>/dev/null || true
            nmcli con mod "$conn" ipv4.ignore-auto-dns yes 2>/dev/null || true
            nmcli con up "$conn" &>/dev/null || true
            info "NetworkManager DNS 设置完成"
        else
            _write_resolv_conf "$v4_1" "$v4_2" "$v6_1" "$v6_2"
        fi

    else
        _write_resolv_conf "$v4_1" "$v4_2" "$v6_1" "$v6_2"
    fi

    # 验证连通性
    if ping -c 1 -W 3 "$v4_1" &>/dev/null; then
        success "DNS 设置成功，${v4_1} 可达 ✓"
    else
        warn "无法 ping 通 ${v4_1}，请检查网络"
    fi
}

# 直接写 resolv.conf（防 DHCP 覆盖）
_write_resolv_conf() {
    local d1="$1" d2="$2" d3="$3" d4="$4"

    # 如果当前是不可变文件，先解锁
    chattr -i /etc/resolv.conf 2>/dev/null || true

    backup_file "/etc/resolv.conf"

    cat > /etc/resolv.conf <<EOF
# Generated by server-optimize - $(date)
nameserver ${d1}
nameserver ${d2}
nameserver ${d3}
nameserver ${d4}
options edns0 trust-ad
EOF

    # 锁定，防止 DHCP 自动覆盖
    chattr +i /etc/resolv.conf 2>/dev/null && \
        step "已锁定 /etc/resolv.conf 防止 DHCP 覆盖" || true

    info "resolv.conf DNS 设置完成"
}

# ============================================================
# 模块 2：BBR TCP 拥塞控制
# ============================================================
setup_bbr() {
    title "BBR TCP 拥塞控制"

    # 检测内核版本
    local kernel_ver
    kernel_ver=$(uname -r)
    local kernel_major kernel_minor
    kernel_major=$(echo "$kernel_ver" | cut -d. -f1)
    kernel_minor=$(echo "$kernel_ver" | cut -d. -f2)

    step "当前内核版本: $kernel_ver"

    if [[ "$kernel_major" -lt 4 ]] || { [[ "$kernel_major" -eq 4 ]] && [[ "$kernel_minor" -lt 9 ]]; }; then
        error "内核版本过低（需要 >= 4.9），BBR 无法启用"
        error "请升级内核后重试"
        return 1
    fi

    if [[ "$kernel_major" -lt 5 ]]; then
        warn "内核版本 $kernel_ver < 5.x，BBR 功能受限，建议升级到 5.x+"
    fi

    # 检查是否已启用 BBR
    local current_cc
    current_cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "unknown")
    step "当前拥塞控制算法: $current_cc"

    if [[ "$current_cc" == "bbr" ]]; then
        local current_qdisc
        current_qdisc=$(sysctl -n net.core.default_qdisc 2>/dev/null || echo "unknown")
        if [[ "$current_qdisc" == "fq" ]]; then
            info "BBR 已经启用，无需重复设置"
            return 0
        fi
    fi

    # 写入 BBR 配置
    step "写入 BBR sysctl 配置..."
    cat > /etc/sysctl.d/99-bbr.conf <<EOF
# BBR TCP 拥塞控制 - server-optimize
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr

# TCP 优化
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_tw_reuse = 1
net.core.rmem_max = 67108864
net.core.wmem_max = 67108864
net.ipv4.tcp_rmem = 4096 87380 67108864
net.ipv4.tcp_wmem = 4096 65536 67108864
net.core.netdev_max_backlog = 30000
net.ipv4.tcp_max_syn_backlog = 8192
EOF

    # 应用配置
    sysctl -p /etc/sysctl.d/99-bbr.conf &>/dev/null

    # 验证
    local new_cc
    new_cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
    local new_qdisc
    new_qdisc=$(sysctl -n net.core.default_qdisc 2>/dev/null)

    if [[ "$new_cc" == "bbr" ]]; then
        success "BBR 启用成功！"
        echo -e "  ${CYAN}拥塞控制: ${GREEN}$new_cc${NC}"
        echo -e "  ${CYAN}队列调度: ${GREEN}$new_qdisc${NC}"
    else
        error "BBR 启用失败，当前算法: $new_cc"
        warn "请检查内核是否支持 BBR: lsmod | grep bbr"
    fi
}

# ============================================================
# 模块 3：虚拟内存（Swap）
# ============================================================
setup_swap() {
    while true; do
        # 读取当前 Swap 用量
        local swap_used swap_total swap_pct
        swap_used=$(free -m | awk '/^Swap:/{print $3}')
        swap_total=$(free -m | awk '/^Swap:/{print $2}')
        if [[ "$swap_total" -gt 0 ]]; then
            swap_pct=$(( swap_used * 100 / swap_total ))
        else
            swap_pct=0
        fi

        echo ""
        echo -e "  ${CYAN}设置虚拟内存${NC}"
        echo -e "  当前虚拟内存: ${YELLOW}${swap_used}M/${swap_total}M (${swap_pct}%)${NC}"
        echo -e "  ${BLUE}------------------------${NC}"
        echo -e "  ${GREEN}1.${NC} 分配1024M         ${GREEN}2.${NC} 分配2048M         ${GREEN}3.${NC} 分配4096M         ${GREEN}4.${NC} 自定义大小"
        echo -e "  ${BLUE}------------------------${NC}"
        echo -e "  ${RED}0.${NC} 返回上一级选单"
        echo -e "  ${BLUE}------------------------${NC}"
        echo -ne "  请输入你的选择: "
        read -r swap_choice

        case "$swap_choice" in
            1) _apply_swap 1024 ;;
            2) _apply_swap 2048 ;;
            3) _apply_swap 4096 ;;
            4)
                echo -ne "  请输入自定义大小(MB): "
                read -r custom_mb
                if [[ "$custom_mb" =~ ^[0-9]+$ ]] && [[ "$custom_mb" -ge 128 ]]; then
                    _apply_swap "$custom_mb"
                else
                    warn "无效大小，请输入不小于 128 的数字"
                fi
                ;;
            0) return 0 ;;
            *) warn "无效选择，请输入 0-4" ;;
        esac

        echo ""
        echo -ne "  ${YELLOW}按 Enter 继续...${NC}"
        read -r
    done
}

# 执行 Swap 创建
_apply_swap() {
    local swap_size_mb="$1"
    local swap_file="/swapfile"

    # 如果已有 Swap，先关闭清除
    local current_swap
    current_swap=$(free -m | awk '/^Swap:/{print $2}')
    if [[ "$current_swap" -gt 0 ]]; then
        step "关闭旧 Swap..."
        swapoff "$swap_file" 2>/dev/null || swapoff -a 2>/dev/null || true
        rm -f "$swap_file"
        sed -i '/swapfile/d' /etc/fstab
        sed -i '/\/swapfile/d' /etc/fstab
    fi

    step "正在创建 ${swap_size_mb}MB Swap 文件..."

    # 创建 Swap 文件
    if command -v fallocate &>/dev/null; then
        fallocate -l "${swap_size_mb}M" "$swap_file"
    else
        dd if=/dev/zero of="$swap_file" bs=1M count="$swap_size_mb" status=progress
    fi

    # 设置权限并激活
    chmod 600 "$swap_file"
    mkswap "$swap_file"
    swapon "$swap_file"

    # 写入 fstab 持久化
    if ! grep -q "$swap_file" /etc/fstab; then
        echo "${swap_file} none swap sw 0 0" >> /etc/fstab
        step "已写入 /etc/fstab 持久化"
    fi

    # 优化 swappiness
    cat > /etc/sysctl.d/99-swap.conf <<EOF
# Swap 优化 - server-optimize
vm.swappiness = 10
vm.vfs_cache_pressure = 50
EOF
    sysctl -p /etc/sysctl.d/99-swap.conf &>/dev/null

    local new_swap
    new_swap=$(free -h | awk '/^Swap:/{print $2}')
    success "Swap 创建成功！当前大小: $new_swap"
    echo -e "  ${CYAN}swappiness: ${GREEN}10  ${CYAN}vfs_cache_pressure: ${GREEN}50${NC}"
}

# ============================================================
# 显示系统信息
# ============================================================
show_sysinfo() {
    echo ""
    echo -e "  ${CYAN}━━━━━━━━━━━━━━━━ 系统信息 ━━━━━━━━━━━━━━━━${NC}"

    # OS
    local os_name
    os_name=$(grep PRETTY_NAME /etc/os-release 2>/dev/null | cut -d'"' -f2 || echo "Unknown")
    echo -e "  ${YELLOW}系统:${NC}   $os_name"

    # 内核
    echo -e "  ${YELLOW}内核:${NC}   $(uname -r)"

    # 内存
    local mem_info
    mem_info=$(free -h | awk '/^Mem:/{print $2 " / " $3 " used"}')
    echo -e "  ${YELLOW}内存:${NC}   $mem_info"

    # Swap
    local swap_info
    swap_info=$(free -h | awk '/^Swap:/{if($2=="0B") print "未配置"; else print $2}')
    echo -e "  ${YELLOW}Swap:${NC}   $swap_info"

    # 当前 DNS
    local dns_servers
    dns_servers=$(grep "^nameserver" /etc/resolv.conf 2>/dev/null | awk '{print $2}' | tr '\n' ' ')
    echo -e "  ${YELLOW}DNS:${NC}    ${dns_servers:-未知}"

    # 当前 TCP 拥塞算法
    local cc
    cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "unknown")
    local cc_mark=""
    [[ "$cc" == "bbr" ]] && cc_mark="${GREEN} ✓${NC}"
    echo -e "  ${YELLOW}TCP CC:${NC} ${cc}${cc_mark}"

    echo -e "  ${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
}

# ============================================================
# 主菜单
# ============================================================
main_menu() {
    while true; do
        clear
        echo -e "${CYAN}"
        echo "  ╔══════════════════════════════════════╗"
        echo "  ║       Linux 服务器一键优化工具       ║"
        echo "  ║    DNS · BBR · Swap · 网络加速       ║"
        echo "  ╚══════════════════════════════════════╝"
        echo -e "${NC}"

        show_sysinfo

        echo -e "  ${GREEN}1.${NC} 设置 DNS (Cloudflare 1.1.1.1 + IPv6)"
        echo -e "  ${GREEN}2.${NC} 开启 BBR TCP 拥塞控制"
        echo -e "  ${GREEN}3.${NC} 配置虚拟内存 (Swap)"
        echo -e "  ${GREEN}4.${NC} ✨ 一键全部执行"
        echo -e "  ${RED}5.${NC} 退出"
        echo ""
        echo -ne "  ${CYAN}请选择 [1-5]:${NC} "
        read -r choice

        case "$choice" in
            1) setup_dns ;;
            2) setup_bbr ;;
            3) setup_swap ;;
            4)
                setup_dns
                setup_bbr
                setup_swap
                echo ""
                success "全部优化已完成！"
                ;;
            5)
                echo ""
                info "感谢使用，再见！"
                exit 0
                ;;
            *)
                warn "无效选择，请输入 1-5"
                ;;
        esac

        echo ""
        echo -ne "  ${YELLOW}按 Enter 返回菜单...${NC}"
        read -r
    done
}

# ============================================================
# 入口
# ============================================================
check_root
detect_os
main_menu
