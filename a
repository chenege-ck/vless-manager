                [[ "$C" != "y" && "$C" != "Y" ]] && return
            fi
            init_reality ;;
        2) init_shadowsocks ;;
        3) init_ws_cf ;;
        4) init_hy2 ;;
        5) init_anytls ;;
        10)
            has_reality || { error "Reality 未启用"; return; }
            read -rp "确认移除 Reality？[y/N]: " C
            [[ "$C" != "y" && "$C" != "Y" ]] && return
            rm -f "$META_REALITY"
            rebuild_config; _inject_all_users; _start_sbox
            info "Reality 已移除" ;;
