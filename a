# ============== sing-box 配置校验 ==============
validate_sbox_config() {
    [[ ! -f "$SBOX_CONFIG" ]] && error "配置文件不存在: $SBOX_CONFIG" && return 1
    python3 -c "import json,sys; json.load(open(sys.argv[1], encoding='utf-8'))" "$SBOX_CONFIG" >/dev/null 2>&1
    local _json_rc=$?
    if [[ $_json_rc -ne 0 ]]; then
        error "config.json 不是合法 JSON"; return 1
    fi
    if [[ ! -x "$SBOX_BIN" ]]; then
        detect_sbox_bin || { error "未找到 sing-box 可执行文件（已查找 /usr/local/bin、/usr/bin、PATH）"; return 1; }
    fi
    local VALIDATE_OUTPUT VALIDATE_RC
    VALIDATE_OUTPUT=$("$SBOX_BIN" check -c "$SBOX_CONFIG" 2>&1)
    VALIDATE_RC=$?
    if [[ $VALIDATE_RC -ne 0 ]]; then
        error "sing-box 配置校验失败:"
        echo "$VALIDATE_OUTPUT" | while IFS= read -r line; do
            echo -e "  ${RED}${line}${NC}"
        done
        return 1
    fi
    return 0
}

# ============== 启动 sing-box ==============
_start_sbox() {
    validate_sbox_config || return 1
    svc_ctrl "$SERVICE_NAME" enable
    svc_ctrl "$SERVICE_NAME" restart
    sleep 1
    if svc_active "$SERVICE_NAME"; then
        info "sing-box 已启动"; return 0
    else
        if [[ "$OS_TYPE" == "alpine" ]]; then
            error "sing-box 启动失败，查看: rc-service $SERVICE_NAME status; tail /var/log/sing-box.err"
        else
            error "sing-box 启动失败，运行 journalctl -u $SERVICE_NAME -n 20 查看日志"
        fi
        return 1
    fi
}

