    has_hy2         && echo -e "  ${GREEN}✓${NC} Hysteria2 已启用"  || echo -e "  ${RED}✗${NC} Hysteria2 未启用"
    has_anytls      && echo -e "  ${GREEN}✓${NC} AnyTLS 已启用"    || echo -e "  ${RED}✗${NC} AnyTLS 未启用"
