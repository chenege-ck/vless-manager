# ============== 系统检测（Debian / Alpine） ==============
OS_TYPE=""
detect_os() {
    if [[ -f /etc/alpine-release ]] || grep -qi "alpine" /etc/os-release 2>/dev/null; then
        OS_TYPE="alpine"
    elif grep -qiE "ID=(debian|ubuntu)" /etc/os-release 2>/dev/null; then
        OS_TYPE="debian"
    else
        error "仅支持 Debian 11/12/13 或 Alpine Linux，不支持当前系统"
        exit 1
    fi
}

check_system() {
    detect_os
    if [[ "$OS_TYPE" == "debian" ]]; then
        local CODENAME
        CODENAME=$(awk -F= '/^VERSION_CODENAME=/{gsub(/"/,"",$2); print $2}' /etc/os-release 2>/dev/null)
        case "$CODENAME" in
            bullseye|bookworm|trixie) ;;
            *) error "仅支持 Debian 11/12/13，当前: ${CODENAME:-unknown}"; exit 1 ;;
        esac
    else
        info "Alpine Linux 已识别"
    fi
}

# ============== 服务控制抽象（systemd / OpenRC） ==============
# svc_ctrl <服务名> <start|stop|restart|enable|disable>
svc_ctrl() {
    local svc="$1" action="$2"
    if [[ "$OS_TYPE" == "alpine" ]]; then
        case "$action" in
            start)   rc-service "$svc" start ;;
            stop)    rc-service "$svc" stop 2>/dev/null ;;
            restart) rc-service "$svc" restart 2>/dev/null || rc-service "$svc" start ;;
            enable)  rc-update add "$svc" default >/dev/null 2>&1 ;;
            disable) rc-update del "$svc" default >/dev/null 2>&1 ;;
        esac
    else
        case "$action" in
            start)   systemctl start "$svc" ;;
            stop)    systemctl stop "$svc" 2>/dev/null ;;
            restart) systemctl restart "$svc" ;;
            enable)  systemctl enable "$svc" >/dev/null 2>&1 ;;
            disable) systemctl disable "$svc" >/dev/null 2>&1 ;;
        esac
    fi
}
# svc_active <服务名> : 0=运行中
svc_active() {
    local svc="$1" proc="$svc"
    [[ "$svc" == "hysteria-server" ]] && proc="hysteria"
    if [[ "$OS_TYPE" == "alpine" ]]; then
        rc-service "$svc" status 2>/dev/null | grep -qi "started" && return 0
        pgrep -x "$proc" >/dev/null 2>&1
    else
        systemctl is-active --quiet "$svc"
    fi
}
svc_reload_daemon() {
    [[ "$OS_TYPE" == "alpine" ]] && return 0
    systemctl daemon-reload 2>/dev/null
}
# 供 Alpine / 回退安装路径写服务文件，ExecStart 用当前实际二进制路径
setup_service_daemon() {
    mkdir -p "$SBOX_DIR"
    if [[ "$OS_TYPE" == "alpine" ]]; then
        cat > /etc/init.d/sing-box <<EOF
#!/sbin/openrc-run
name="sing-box"
description="sing-box service"
command="${SBOX_BIN}"
command_args="run -c ${SBOX_CONFIG}"
command_background="yes"
pidfile="/run/sing-box.pid"
output_log="/var/log/sing-box.log"
error_log="/var/log/sing-box.err"

depend() {
    need net
    after firewall
}
EOF
        chmod +x /etc/init.d/sing-box
    else
        cat > /etc/systemd/system/sing-box.service <<EOF
[Unit]
Description=sing-box service
Documentation=https://sing-box.sagernet.org
After=network.target nss-lookup.target

[Service]
