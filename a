# 时间一律用 Python 算，不依赖 GNU date -d（BusyBox date 语法不同）
now_shanghai_ts() { python3 -c 'import time; print(int(time.time()))' 2>/dev/null || date +%s; }

expire_noon_str() {
    local days="$1"
    python3 -c "import datetime; print((datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=8))) + datetime.timedelta(days=int('$days'))).strftime('%Y-%m-%d_12-00-00'))" 2>/dev/null
}

expire_to_ts() {
    local expire="$1"
    python3 - "$expire" <<'PYEOF' 2>/dev/null
import datetime, sys
exp = sys.argv[1].strip()
tz = datetime.timezone(datetime.timedelta(hours=8))
for fmt in ('%Y-%m-%d_%H-%M-%S', '%Y-%m-%dT%H:%M:%S', '%Y-%m-%d %H:%M:%S', '%Y-%m-%d'):
    try:
        dt = datetime.datetime.strptime(exp, fmt)
        if fmt == '%Y-%m-%d':
            dt = dt.replace(hour=12, minute=0, second=0)
        print(int(dt.replace(tzinfo=tz).timestamp()))
        sys.exit(0)
    except Exception:
        pass
print(0)
PYEOF
}

expire_display() {
    local expire="$1"
    if [[ "$expire" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}$ ]]; then
        local d="${expire%%_*}" t="${expire#*_}"; echo "${d} ${t//-/:}"
    elif [[ "$expire" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$ ]]; then
        echo "${expire/T/ }"
    elif [[ "$expire" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        echo "${expire} 12:00:00"
    else
        echo "$expire"
    fi
}

# ============== 获取公网 IP ==============
get_public_ip() {
    local ip=""
    local cand=""
    for cand in "$(curl -s4 --max-time 5 ip.sb 2>/dev/null)" "$(curl -s4 --max-time 5 ifconfig.me 2>/dev/null)" "$(curl -s4 --max-time 5 api.ipify.org 2>/dev/null)"; do
        if [[ "$cand" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then ip="$cand"; break; fi
    done
    if [[ -z "$ip" ]]; then
        for cand in "$(curl -s6 --max-time 5 ip.sb 2>/dev/null)" "$(curl -s6 --max-time 5 ifconfig.me 2>/dev/null)"; do
            if [[ "$cand" == *:* ]]; then ip="$cand"; break; fi
        done
    fi
    echo "${ip:-<请手动填写服务器IP>}"
}

# ============== 端口检查 ==============
# 端口检查：优先 Python 绑定测试（内核级，不解析 ss 文本；只有 EADDRINUSE 算占用）
# 兜底 ss 精确匹配（awk 数值比较，2151 不会匹配 21510）；无任何手段时按占用处理
check_port() {
    local port="$1"
    [[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )) || return 1
    local py_bin=""
    for py_bin in "$(command -v python3 2>/dev/null)" /usr/bin/python3 /usr/local/bin/python3; do
        [[ -n "$py_bin" && -x "$py_bin" ]] && break
        py_bin=""
    done
    if [[ -n "$py_bin" ]]; then
        "$py_bin" - "$port" <<'PYEOF' 2>/dev/null
import errno, socket, sys
port = int(sys.argv[1])
occupied = False
for family, addr in ((socket.AF_INET, ("0.0.0.0", port)),
                      (socket.AF_INET6, ("::", port))):
    try:
        s = socket.socket(family, socket.SOCK_STREAM)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s.bind(addr)
        s.close()
    except OSError as e:
        if e.errno == errno.EADDRINUSE:
            occupied = True
        pass
sys.exit(1 if occupied else 0)
PYEOF
        return $?
    fi
    local ss_bin=""
    for ss_bin in "$(command -v ss 2>/dev/null)" /usr/bin/ss /bin/ss /usr/sbin/ss /sbin/ss; do
        [[ -n "$ss_bin" && -x "$ss_bin" ]] && break
        ss_bin=""
    done
    if [[ -n "$ss_bin" ]]; then
        "$ss_bin" -tlnH 2>/dev/null | awk -v p="$port" '{ for (i=1; i<=NF; i++) { n=split($i, a, ":"); if (n>1 && a[n]==p) found=1 } } END { exit !found }' && return 1 || return 0
    fi
    return 1
}
