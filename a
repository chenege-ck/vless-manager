    has_reality     && echo -e "  ${RED}10.${NC} 移除 Reality"
    has_shadowsocks && echo -e "  ${RED}11.${NC} 移除 Shadowsocks"
    has_ws          && echo -e "  ${RED}12.${NC} 移除 WS+CF"
    has_hy2         && echo -e "  ${RED}13.${NC} 移除 Hysteria2"
    has_anytls      && echo -e "  ${RED}14.${NC} 移除 AnyTLS"
    echo ""
    read -rp "选择: " MODE_SEL
    case $MODE_SEL in
