            ;;
        *) error "不支持的版本: $CODENAME"; return 1 ;;
    esac
    apt-get update -qq
    [[ $? -ne 0 ]] && error "apt 源修复后仍然失败" && return 1
    info "apt 源已修复: ${CODENAME}"
    return 0
}

# ============================================================
# 查找 sing-box（官方 deb 通常安装到 /usr/bin）
# ============================================================
detect_sbox_bin() {
    local candidate
    for candidate in /usr/local/bin/sing-box /usr/bin/sing-box "$(command -v sing-box 2>/dev/null)"; do
        [[ -n "$candidate" && -x "$candidate" ]] || continue
        if "$candidate" version >/dev/null 2>&1; then
            SBOX_BIN="$candidate"
            return 0
        fi
    done
    return 1
}

# ============================================================
# 安装 sing-box
# ============================================================
install_sbox() {
    title "安装 sing-box..."
    if detect_sbox_bin; then
        warn "sing-box 已安装，跳过安装步骤"
        setup_service_daemon
        return 0
    fi
    install_deps || return 1

    local ARCH
    ARCH=$(uname -m)
    case "$ARCH" in
        x86_64)  ARCH="amd64" ;;
        aarch64) ARCH="arm64" ;;
        armv7l)  ARCH="armv7" ;;
        *) error "不支持的架构: $ARCH"; return 1 ;;
    esac

    if [[ "$OS_TYPE" == "debian" ]]; then
        info "正在下载 sing-box（Debian 官方 deb）..."
        bash <(curl -fsSL https://sing-box.app/deb-install.sh)
        if detect_sbox_bin; then
            mkdir -p "$SBOX_DIR"
            info "sing-box 安装成功: $($SBOX_BIN version 2>/dev/null | head -1)"
            return 0
        fi
        warn "官方 deb 脚本安装失败，改用 GitHub releases 手动安装..."
    fi

    # 通用回退 / Alpine 主路径：GitHub releases tar.gz（Alpine 用 musl 静态版）
    local VER URL RELEASE_PAGE="https://github.com/SagerNet/sing-box/releases/latest"
    VER=$(curl -fsSL -L --max-time 15 -o /dev/null -w '%{url_effective}' "$RELEASE_PAGE" 2>/dev/null \
          | sed -nE 's#^.*/tag/v([0-9]+\.[0-9]+\.[0-9]+)$#\1#p' | head -n 1)
    [[ ! "$VER" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && error "无法获取 sing-box 最新版本" && return 1
    local SUFFIX=""
    [[ "$OS_TYPE" == "alpine" ]] && SUFFIX="-musl" && info "Alpine：使用 musl 静态版 sing-box-${VER}-linux-${ARCH}-musl"
    URL="https://github.com/SagerNet/sing-box/releases/download/v${VER}/sing-box-${VER}-linux-${ARCH}${SUFFIX}.tar.gz"
    rm -f /tmp/sing-box.tar.gz
    curl -fsSL "$URL" -o /tmp/sing-box.tar.gz || { error "下载失败"; return 1; }
    rm -rf /tmp/sbox_extract
    mkdir -p /tmp/sbox_extract
    tar -xzf /tmp/sing-box.tar.gz -C /tmp/sbox_extract/ || { error "解压失败"; rm -rf /tmp/sing-box.tar.gz /tmp/sbox_extract; return 1; }
    local BIN_FOUND
    BIN_FOUND=$(find /tmp/sbox_extract -type f -name "sing-box" | head -n 1)
    [[ -n "$BIN_FOUND" && -f "$BIN_FOUND" ]] || { error "未在解压包中找到 sing-box 二进制"; rm -rf /tmp/sing-box.tar.gz /tmp/sbox_extract; return 1; }
    mkdir -p "$(dirname "$SBOX_BIN")" "$SBOX_DIR"
    cp -f "$BIN_FOUND" "$SBOX_BIN"
    chmod +x "$SBOX_BIN"
    rm -rf /tmp/sing-box.tar.gz /tmp/sbox_extract
    setup_service_daemon
    detect_sbox_bin || { error "sing-box 安装失败"; return 1; }
    info "sing-box 安装成功: $($SBOX_BIN version 2>/dev/null | head -1)"
}

# ============================================================
# 卸载 sing-box（真卸载：只针对本脚本 v2.0.1 生成的内容）
# 删：sing-box/hysteria 二进制、管理脚本+c、/etc/sing-box、/etc/hysteria、
#     systemd/OpenRC 服务文件、cron 到期检查、logrotate、相关日志与临时文件、
#     Debian deb 包（apt purge）、fix_apt 留下的 sources.list 备份（先从最新备份恢复源）
# 不删：curl/python3/openssl 等共享依赖、系统时区
# ============================================================
uninstall_sbox() {
    title "卸载 sing-box..."
    read -rp "确认卸载？将删除所有配置和用户数据 [y/N]: " CONFIRM
    [[ "$CONFIRM" != "y" && "$CONFIRM" != "Y" ]] && warn "已取消" && return

    # 1. 停全部相关服务（含独立服务）
    svc_ctrl "$SERVICE_NAME" stop
    svc_ctrl "$SERVICE_NAME" disable
    svc_ctrl "hysteria-server" stop
    svc_ctrl "hysteria-server" disable
    # 2. 删服务文件（systemd + OpenRC 两边都清）
    rm -f /etc/systemd/system/sing-box.service
    rm -f /etc/systemd/system/hysteria-server.service
    rm -f /etc/init.d/sing-box
    rm -f /etc/init.d/hysteria-server
    svc_reload_daemon
    [[ "$OS_TYPE" != "alpine" ]] && systemctl reset-failed 2>/dev/null
    # Debian deb 包：只删二进制会留下 dpkg 记录和 /lib 下的 unit，改为 purge
    if [[ "$OS_TYPE" == "debian" ]] && command -v dpkg >/dev/null 2>&1 && dpkg -l sing-box 2>/dev/null | grep -q '^ii'; then
        info "正在 apt purge sing-box（deb 包）..."
        DEBIAN_FRONTEND=noninteractive apt-get purge -y -qq sing-box 2>/dev/null || warn "apt purge sing-box 失败，继续删除文件"
    fi
    # 3. 删二进制与快捷命令（含更新残留）
    rm -f "$SBOX_BIN" /usr/local/bin/sing-box /usr/bin/sing-box
    rm -f /usr/local/bin/hysteria /usr/local/bin/hysteria.bak /usr/local/bin/hysteria.new
    rm -f /usr/local/bin/singbox_manager.sh
    rm -f /usr/local/bin/c
    # 4. 删全部配置与元数据（含 sing-box / hysteria / SSL）
    rm -rf "$SBOX_DIR"
    rm -rf /etc/hysteria
    # 5. 清 cron 与 logrotate（含过期检查与日志）
    if crontab -l 2>/dev/null | grep -q "check-expire"; then
        crontab -l 2>/dev/null | grep -v "check-expire" | grep -v "quota-collect" | grep -v "quota-reset" > /tmp/sbox-cron.tmp
        crontab /tmp/sbox-cron.tmp 2>/dev/null || crontab -r 2>/dev/null
        rm -f /tmp/sbox-cron.tmp
    fi
    rm -f /etc/logrotate.d/sbox-expire
    rm -f /var/log/sbox-expire.log /var/log/sbox-expire.log.*
    rm -f /var/log/sing-box.log /var/log/sing-box.err
    rm -rf /var/lib/sbox
    # 6. 删脚本生成的其他文件
    rm -rf /var/www/masq
    rm -f /tmp/sing-box.tar.gz /tmp/singbox_new.sh
    rm -rf /tmp/sbox_extract
    # fix_apt 备份：从最新备份恢复 sources.list，再删备份（不恢复会丢源，不删会留尾巴）
    if [[ "$OS_TYPE" == "debian" ]]; then
        local _bak
        _bak=$(ls -t /etc/apt/sources.list.bak.* 2>/dev/null | head -n 1)
        if [[ -n "$_bak" && -s "$_bak" ]]; then
            cp -f "$_bak" /etc/apt/sources.list && info "apt 源已从备份恢复: $_bak"
        fi
        rm -f /etc/apt/sources.list.bak.*
    fi
    # 7. 打印残留自检（v2.0 生成的全部路径）
    echo ""
    echo "残留自检："
    local leftover=0
    for f in /usr/local/bin/sing-box /usr/bin/sing-box /usr/local/bin/hysteria /usr/local/bin/singbox_manager.sh /usr/local/bin/c /etc/sing-box /etc/hysteria /etc/systemd/system/sing-box.service /etc/systemd/system/hysteria-server.service /etc/init.d/sing-box /etc/init.d/hysteria-server /var/www/masq /var/log/sing-box.log; do
        if [[ -e "$f" ]]; then echo "  残留: $f"; leftover=1; fi
    done
    if crontab -l 2>/dev/null | grep -q "check-expire"; then echo "  残留: cron check-expire"; leftover=1; fi
    if [[ "$OS_TYPE" == "debian" ]] && systemctl list-unit-files 2>/dev/null | grep -qE "sing-box|hysteria-server"; then echo "  残留: systemd unit-file"; leftover=1; fi
    if [[ "$OS_TYPE" == "alpine" ]] && rc-update show 2>/dev/null | grep -qE "sing-box|hysteria-server"; then echo "  残留: OpenRC 服务"; leftover=1; fi
    [[ "$leftover" -eq 0 ]] && info "无残留，sing-box 已完全卸载" || warn "存在残留，请按上面路径手动处理"
    exit 0
}

# ============================================================
# 生成 Reality 密钥对
# ============================================================
gen_keypair() {
    PRIVATE_KEY=""
    PUBLIC_KEY=""
    if ! detect_sbox_bin; then
        error "找不到可用的 sing-box，请先运行「一键安装」"
        return 1
    fi

    local OUTPUT STATUS
    OUTPUT=$("$SBOX_BIN" generate reality-keypair 2>&1)
    STATUS=$?
    if [[ $STATUS -ne 0 ]]; then
        error "sing-box 密钥生成失败: ${OUTPUT:-未知错误}"
        return 1
    fi

    PRIVATE_KEY=$(printf '%s\n' "$OUTPUT" | awk '
        {
            line = $0
            sub(/\r$/, "", line)
            lowered = tolower(line)
            if (index(lowered, "privatekey:") > 0) {
                sub(/^[^:]*:[[:space:]]*/, "", line)
                print line
                exit
            }
        }')
    PUBLIC_KEY=$(printf '%s\n' "$OUTPUT" | awk '
        {
            line = $0
            sub(/\r$/, "", line)
            lowered = tolower(line)
            if (index(lowered, "publickey:") > 0) {
                sub(/^[^:]*:[[:space:]]*/, "", line)
                print line
                exit
            }
        }')
    if [[ -z "$PRIVATE_KEY" || -z "$PUBLIC_KEY" ]]; then
        error "无法解析 Reality 密钥输出: ${OUTPUT}"
        return 1
    fi
    if [[ "$PRIVATE_KEY" == "$PUBLIC_KEY" ]]; then
        error "Reality 私钥与公钥不应相同，请重新生成"
        return 1
    fi
}

# ============================================================
# IP 优先级设置
# ============================================================
_read_ip_priority() {
    local ds=""
    [[ -f "$META" ]] && ds=$(read_kv "$META" "IP_PRIORITY")
    echo "$ds"
}

_get_ip_priority_desc() {
    local ds
    ds=$(_read_ip_priority)
    case "$ds" in
        prefer_ipv4) echo "IPv4 优先（v4失败自动切v6）" ;;
        prefer_ipv6) echo "IPv6 优先（v6失败自动切v4）" ;;
        ipv4_only)   echo "仅 IPv4" ;;
        ipv6_only)   echo "仅 IPv6" ;;
        *)           echo "系统默认" ;;
    esac
}

_save_ip_priority() {
    local ds="$1"
    mkdir -p "$(dirname "$META")"
    touch "$META"
    if grep -q "^IP_PRIORITY=" "$META" 2>/dev/null; then
        sed -i "s|^IP_PRIORITY=.*|IP_PRIORITY=${ds}|" "$META"
    else
        echo "IP_PRIORITY=${ds}" >> "$META"
    fi
}

ip_priority_menu() {
    title "网络优先级（IPv4/IPv6）"
    load_meta
    local CURRENT_DESC
    CURRENT_DESC=$(_get_ip_priority_desc)
    echo ""
    echo -e "当前模式：${CYAN}${CURRENT_DESC}${NC}"
    echo -e "${YELLOW}（Reality / SS / WS / Hysteria2 统一生效）${NC}"
    echo ""
    echo -e "  ${GREEN}1.${NC} IPv4 优先   — 优先走 v4，v4 不通自动切 v6"
    echo -e "  ${GREEN}2.${NC} IPv6 优先   — 优先走 v6，v6 不通自动切 v4"
    echo -e "  ${GREEN}3.${NC} 仅 IPv4     — 强制只走 v4"
    echo -e "  ${GREEN}4.${NC} 仅 IPv6     — 强制只走 v6"
    echo -e "  ${GREEN}5.${NC} 系统默认"
    echo -e "  ${GREEN}0.${NC} 返回"
    echo ""
    read -rp "选择: " OPT
    local DS=""
    local DESC=""
    case "$OPT" in
        1) DS="prefer_ipv4"; DESC="IPv4 优先" ;;
        2) DS="prefer_ipv6"; DESC="IPv6 优先" ;;
        3) DS="ipv4_only";   DESC="仅 IPv4" ;;
        4) DS="ipv6_only";   DESC="仅 IPv6" ;;
        5) DS="AsIs";        DESC="系统默认" ;;
        0) return ;;
        *) warn "无效选项"; return ;;
    esac
    _save_ip_priority "$DS"
    if has_reality || has_shadowsocks || has_ws || has_hy2 || has_anytls; then
        if ! rebuild_config; then
            error "配置重建失败，设置已保存但尚未生效"
            return 1
        fi
        if ! _inject_all_users; then
            error "用户注入失败，设置已保存但尚未确认生效"
            return 1
        fi
        if ! _start_sbox; then
            error "sing-box 校验或重启失败，设置已保存但尚未生效"
            return 1
        fi
    fi
    info "已保存：${DESC}"
}

# ============================================================
# 根据已有 meta 重建 sing-box config.json
# ============================================================
rebuild_config() {
    load_meta
    local IP_PRIO
    IP_PRIO=$(_read_ip_priority)

    HAS_REALITY=0; has_reality && HAS_REALITY=1
    HAS_SS=0; has_shadowsocks && HAS_SS=1
    HAS_WS=0; has_ws && HAS_WS=1
    HAS_HY2=0; has_hy2 && HAS_HY2=1
    HAS_ANYTLS=0; has_anytls && HAS_ANYTLS=1

    export SBOX_CONFIG HAS_REALITY HAS_SS HAS_WS HAS_HY2 HAS_ANYTLS IP_PRIO
    export REALITY_PORT REALITY_SNI REALITY_PRIVATE_KEY REALITY_SHORTID
    export SS_PORT SS_METHOD SS_PASSWORD
    export WS_PORT WS_PATH CERT_DIR
    export ANYTLS_PORT ANYTLS_PASSWORD ANYTLS_SNI ANYTLS_PRIVATE_KEY ANYTLS_SHORTID
    # 端口先校验：空/非数字会在下面 int() 抛错，提前拦住，避免 config.json 写一半
    for _p in "$REALITY_PORT" "$SS_PORT" "$WS_PORT" "$ANYTLS_PORT"; do
        [[ -z "$_p" ]] && continue
        [[ "$_p" =~ ^[0-9]+$ ]] && (( _p >= 1 && _p <= 65535 )) || { error "端口无效: ${_p}"; return 1; }
    done

    python3 - <<PYEOF
import json, os

cfg = {"log": {"level": "warn", "timestamp": True}, "inbounds": [], "outbounds": []}

if os.environ.get("HAS_REALITY") == "1":
    cfg["inbounds"].append({
        "type": "vless", "tag": "inbound-reality",
        "listen": "::", "listen_port": int(os.environ["REALITY_PORT"]),
        "users": [],
        "tls": {
            "enabled": True, "server_name": os.environ["REALITY_SNI"],
            "reality": {
                "enabled": True,
                "handshake": {"server": os.environ["REALITY_SNI"], "server_port": 443},
                "private_key": os.environ["REALITY_PRIVATE_KEY"],
                "short_id": [os.environ["REALITY_SHORTID"]]
            }
        }
    })

if os.environ.get("HAS_SS") == "1":
    # SS 多用户（SS-2022 EIH）：顶层 password 是服务端主密钥（老单密码客户端继续能用），
    # users[] 是各用户独立 EIH 密钥，由 _inject_all_users 按 users.db 注入
    cfg["inbounds"].append({
        "type": "shadowsocks", "tag": "inbound-shadowsocks",
        "listen": "::", "listen_port": int(os.environ["SS_PORT"]),
        "method": os.environ["SS_METHOD"], "password": os.environ["SS_PASSWORD"],
        "users": []
    })

if os.environ.get("HAS_WS") == "1":
    cfg["inbounds"].append({
        "type": "vless", "tag": "inbound-ws",
        "listen": "::", "listen_port": int(os.environ["WS_PORT"]),
        "users": [],
        "tls": {
            "enabled": True,
            "certificate_path": os.environ["CERT_DIR"] + "/ws.crt",
            "key_path": os.environ["CERT_DIR"] + "/ws.key"
        },
        "transport": {
            "type": "ws", "path": os.environ["WS_PATH"],
            "max_early_data": 2048,
            "early_data_header_name": "Sec-WebSocket-Protocol"
        }
    })

if os.environ.get("HAS_ANYTLS") == "1":
    cfg["inbounds"].append({
        "type": "anytls", "tag": "inbound-anytls",
        "listen": "::", "listen_port": int(os.environ["ANYTLS_PORT"]),
        "users": [{"name": "shared", "password": os.environ["ANYTLS_PASSWORD"]}],
        "tls": {
            "enabled": True,
            "server_name": os.environ["ANYTLS_SNI"],
            "reality": {
                "enabled": True,
                "handshake": {"server": os.environ["ANYTLS_SNI"], "server_port": 443},
                "private_key": os.environ["ANYTLS_PRIVATE_KEY"],
                "short_id": [os.environ["ANYTLS_SHORTID"]]
            }
        }
    })

ds = os.environ.get("IP_PRIO", "")
outbound = {"type": "direct", "tag": "direct"}
if ds and ds != "AsIs":
    # sing-box 1.12+：使用 domain_resolver 替代已弃用的 domain_strategy
    cfg["dns"] = {
        "servers": [
            {"type": "local", "tag": "local"}
        ]
    }
    outbound["domain_resolver"] = {
        "server": "local",
        "strategy": ds
    }

cfg["outbounds"] = [outbound, {"type": "block", "tag": "block"}]

cfg["route"] = {
    "rules": [
        {"protocol": "dns", "action": "hijack-dns"},
        {"action": "sniff"}
    ],
    "final": "direct"
}

with open(os.environ["SBOX_CONFIG"], "w", encoding="utf-8") as f:
    json.dump(cfg, f, indent=2)
PYEOF
    # 重建配置后，把 DB 里所有 active 用户重新注入，避免 users 为空导致节点无法连接
    _inject_all_users
}

# ============================================================
# 注入用户到 config.json（Reality/WS 用 UUID，SS 用独立密码）
# 用法：_inject_user <UUID> <NAME> <EXPIRE> <NODE> [SSPASS]
# ============================================================
_inject_user() {
    local UUID=$1 NAME=$2 EXPIRE=$3 NODE=$4 SSPASS=${5:-}

    INJECT_UUID="$UUID" INJECT_NAME="$NAME" INJECT_NODE="$NODE" INJECT_SSPASS="$SSPASS" \
    INJECT_CONFIG="$SBOX_CONFIG" python3 - <<'PYEOF'
import json, os
uuid = os.environ["INJECT_UUID"]
name = os.environ["INJECT_NAME"]
node = os.environ["INJECT_NODE"]
sspass = os.environ.get("INJECT_SSPASS", "")
cfg_path = os.environ["INJECT_CONFIG"]

with open(cfg_path, "r", encoding="utf-8") as f:
    cfg = json.load(f)

# VLESS inbound tags 允许注入用户
VLESS_TAGS = {"inbound-reality", "inbound-ws"}

for inbound in cfg.get("inbounds", []):
    tag = inbound.get("tag", "")
    users = inbound.get("users")
    if users is None:
        continue
    # SS 入口：按用户名(name)管理独立 EIH 密码
    if tag == "inbound-shadowsocks":
        # single-password mode: only master password works, drop per-user entries
        inbound["users"] = [u for u in users if u.get("name") != name]
        continue
    # 仅对 VLESS 节点操作用户列表，跳过 Hysteria2 / AnyTLS 等
    if tag not in VLESS_TAGS:
        continue
    # 移除已存在的同 UUID 用户
    inbound["users"] = [u for u in users if u.get("uuid") != uuid]
    # 按节点类型注入
    should_add = False
    if node == "both":
        should_add = True
    elif node == "reality" and tag == "inbound-reality":
        should_add = True
    elif node == "ws" and tag == "inbound-ws":
        should_add = True
    if should_add:
        user_entry = {"name": name, "uuid": uuid}
        if tag == "inbound-reality":
            user_entry["flow"] = "xtls-rprx-vision"
        inbound["users"].append(user_entry)

with open(cfg_path, "w", encoding="utf-8") as f:
    json.dump(cfg, f, indent=2)
PYEOF
}

# ============================================================
# 重建后将所有 active 用户重新注入
# ============================================================
_inject_all_users() {
    [[ ! -f "$USER_DB" ]] && return
    normalize_user_db
    while IFS=: read -r NAME UUID EXPIRE STATUS NODE SSPASS _REST; do
        [[ "$STATUS" != "active" ]] && continue
        NODE=${NODE:-both}
        _inject_user "$UUID" "$NAME" "$EXPIRE" "$NODE" "$SSPASS"
    done < "$USER_DB"
}

# ============================================================
# 初始化 Reality 节点
# ============================================================
init_reality() {
    title "配置 VLESS + Reality"
    gen_keypair || return 1

    while true; do
        read -rp "监听端口 [默认 8443]: " REALITY_PORT
        REALITY_PORT=${REALITY_PORT:-8443}
