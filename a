# ============================================================
# 清理旧版本遗留（Telegram 机器人 / 流量统计）
# ============================================================
cleanup_legacy() {
    local touched=0
    if [[ -f /etc/systemd/system/sbox-tgbot.service || -d /etc/vless-manager ]]; then
        systemctl disable --now sbox-tgbot.service >/dev/null 2>&1 || true
        rm -f /etc/systemd/system/sbox-tgbot.service
        rm -rf /etc/vless-manager
        systemctl daemon-reload 2>/dev/null
        touched=1
    fi
    if crontab -l 2>/dev/null | grep -qE "quota-collect|quota-reset"; then
        crontab -l 2>/dev/null | grep -vE "quota-collect|quota-reset" | crontab - 2>/dev/null
        touched=1
    fi
    rm -rf /var/lib/sbox 2>/dev/null
    [[ $touched -eq 1 ]] && info "已清理旧版 Telegram 机器人 / 流量统计残留"
    return 0
}


