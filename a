# ============================================================
# 初始化 WS+CF 节点
# ============================================================
init_ws_cf() {
    title "配置 VLESS + WS + TLS"
    while true; do
        read -rp "监听端口 [默认 8445]: " WS_PORT
        WS_PORT=${WS_PORT:-8445}
        [[ "$WS_PORT" =~ ^[0-9]+$ ]] && (( WS_PORT >= 1 && WS_PORT <= 65535 )) || { warn "端口必须是 1-65535"; continue; }
        check_port "$WS_PORT" && break || warn "端口 ${WS_PORT} 已被占用"
    done
    read -rp "WS 路径 [默认 /vless]: " WS_PATH
    WS_PATH=${WS_PATH:-/vless}
    [[ "$WS_PATH" == /* ]] || { error "WS 路径必须以 / 开头"; return 1; }
    read -rp "你的域名（已在 CF 解析）: " WS_DOMAIN
    [[ -z "$WS_DOMAIN" ]] && error "域名不能为空" && return 1
    [[ "$WS_DOMAIN" =~ ^[A-Za-z0-9.-]+$ ]] || { error "域名格式异常"; return 1; }

    CERT_DIR="/etc/sing-box/ssl"
    mkdir -p "$CERT_DIR"
    if [[ -s "${CERT_DIR}/ws.crt" || -s "${CERT_DIR}/ws.key" ]]; then
        local _ts
        _ts=$(date +%s)
        cp -f "${CERT_DIR}/ws.crt" "${CERT_DIR}/ws.crt.bak.${_ts}" 2>/dev/null
        cp -f "${CERT_DIR}/ws.key" "${CERT_DIR}/ws.key.bak.${_ts}" 2>/dev/null
        info "已有证书已备份为 ws.crt.bak.${_ts} / ws.key.bak.${_ts}"
    fi
    openssl req -x509 -nodes -newkey ec -pkeyopt ec_paramgen_curve:P-256 \
        -keyout "${CERT_DIR}/ws.key" -out "${CERT_DIR}/ws.crt" \
        -days 3650 -subj "/CN=${WS_DOMAIN}" \
        -addext "subjectAltName=DNS:${WS_DOMAIN}" 2>/dev/null || {
        error "自签证书生成失败"; return 1
    }
    chmod 640 "${CERT_DIR}/ws.key"
    chmod 644 "${CERT_DIR}/ws.crt"

    cat > "$META_WS" <<EOF
WS_PORT=${WS_PORT}
WS_PATH=${WS_PATH}
WS_DOMAIN=${WS_DOMAIN}
WS_CF_PORT=${WS_PORT}
WS_TLS=tls
CERT_DIR=${CERT_DIR}
EOF
    chmod 600 "$META_WS"

    rebuild_config || return 1
    _inject_all_users
    _start_sbox || return 1
    info "WS+CF 节点配置完成"
    echo -e "${YELLOW}CF 配置：${NC}${WS_DOMAIN} 解析到本机并开启橙云，SSL 使用完全（Full）"
}

# ============================================================
# ============================================================
# Hysteria2（独立官方 hysteria server v2.12.x，二次重构成独立服务体系，不走 sing-box）
# ============================================================
HY_BIN="/usr/local/bin/hysteria"
HY_SERVICE="hysteria-server.service"
HY_CONF="/etc/hysteria/config.yaml"
HY_DIR="/etc/hysteria"
HY_CERT_F="/etc/hysteria/server.crt"
HY_KEY_F="/etc/hysteria/server.key"

detect_hyst_arch(){
    case "$(uname -m)" in
        x86_64|amd64)  echo "hysteria-linux-amd64" ;;
        aarch64|arm64) echo "hysteria-linux-arm64" ;;
        armv7l|armv6l) echo "hysteria-linux-arm" ;;
        riscv64)       echo "hysteria-linux-riscv64" ;;
        s390x)         echo "hysteria-linux-s390x" ;;
        i386|i686)     echo "hysteria-linux-386" ;;
        *) return 1 ;;
    esac
}

hy_installed_ver(){
    [[ -x "$HY_BIN" ]] || return 1
    "$HY_BIN" version 2>/dev/null | head -1 | sed -E 's/.*v([0-9]+\.[0-9]+\.[0-9]+).*/\1/'
}
install_hysteria(){
    title "安装官方 Hysteria"
    if ! command -v curl >/dev/null 2>&1; then
        if [[ "$OS_TYPE" == "alpine" ]]; then apk add --no-cache curl >/dev/null 2>&1; else apt-get install -y -qq curl >/dev/null 2>&1; fi
    fi
    if [[ -x "$HY_BIN" ]]; then
        info "已安装 Hysteria: $(hy_installed_ver || echo 未知)"
        return 0
    fi
    local FN DOWNLOAD
    FN=$(detect_hyst_arch) || { error "不支持的架构: $(uname -m)"; return 1; }
    DOWNLOAD="https://download.hysteria.network/app/latest/${FN}"
    info "下载: ${DOWNLOAD}"
    curl -fsSL --max-time 120 "$DOWNLOAD" -o "$HY_BIN" || { error "下载失败"; return 1; }
    chmod +x "$HY_BIN"
    [[ -x "$HY_BIN" ]] || { error "安装失败"; return 1; }
    info "hysteria 安装成功: $("$HY_BIN" version | head -1)"
}

_gen_hy2_cert(){
    local SNI="$1"
    mkdir -p "$HY_DIR"
    if [[ -s "$HY_CERT_F" && -s "$HY_KEY_F" ]]; then
        if openssl x509 -noout -subject -in "$HY_CERT_F" 2>/dev/null | grep -q "$SNI"; then
            warn "证书已存在且 SNI 一致，保留现有证书"
            return 0
        fi
        warn "已有证书 SNI 与 ${SNI} 不一致，重新生成证书"
        rm -f "$HY_CERT_F" "$HY_KEY_F"
    fi
    openssl req -x509 -nodes -newkey rsa:2048 \
        -keyout "$HY_KEY_F" -out "$HY_CERT_F" \
        -days 3650 -subj "/CN=${SNI}" \
        -addext "subjectAltName=DNS:${SNI}" >/dev/null 2>&1
    [[ -s "$HY_CERT_F" && -s "$HY_KEY_F" ]] || { error "证书生成失败"; return 1; }
    chmod 644 "$HY_CERT_F"; chmod 600 "$HY_KEY_F"
    return 0
}

_setup_hy2_service(){
    if [[ "$OS_TYPE" == "alpine" ]]; then
        cat > /etc/init.d/hysteria-server <<EOF
#!/sbin/openrc-run
name="hysteria-server"
description="Hysteria2 server (official)"
command="${HY_BIN}"
command_args="server -c ${HY_CONF}"
command_background="yes"
pidfile="/run/hysteria-server.pid"
output_log="/var/log/hysteria-server.log"
error_log="/var/log/hysteria-server.err"

depend() {
    need net
    after firewall
}
EOF
        chmod +x /etc/init.d/hysteria-server
    else
        cat > /etc/systemd/system/hysteria-server.service <<EOF
[Unit]
Description=Hysteria2 server (official)
After=network.target nss-lookup.target
[Service]
Type=simple
ExecStart=${HY_BIN} server -c ${HY_CONF}
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
[Install]
WantedBy=multi-user.target
EOF
        systemctl daemon-reload
    fi
}

_start_hy2_service(){
    svc_ctrl "$HY_SERVICE" enable
    svc_ctrl "$HY_SERVICE" restart
    sleep 2
    if svc_active "$HY_SERVICE"; then
        info "hysteria 服务运行中"
        return 0
    else
        error "hysteria 启动失败:"
        if [[ "$OS_TYPE" == "alpine" ]]; then
            tail -15 /var/log/hysteria-server.err 2>/dev/null || tail -15 /var/log/hysteria-server.log 2>/dev/null
        else
            journalctl -u "$HY_SERVICE" -n 15 --no-pager 2>&1 | tail -15
        fi
        return 1
    fi
}

init_hy2() {
    title "配置 Hysteria2（独立官方 hysteria,BBR不限速）"

    if has_hy2; then
        warn "Hysteria2 已存在，重新配置将覆盖并重启服务"
        read -rp "确认继续？[y/N]: " C
        [[ "$C" != "y" && "$C" != "Y" ]] && warn "已取消" && return
    fi

    local PORT SNI PASS HOP_ASK HOP_RANGE HOP_START HOP_END
    read -rp "监听端口 [默认 443]: " PORT
    PORT=${PORT:-443}
    if ! [[ "$PORT" =~ ^[0-9]+$ ]] || (( PORT < 1 || PORT > 65535 )); then
        error "端口必须是 1-65535"; return 1
    fi
    check_port "$PORT" || { error "端口 ${PORT} 已被占用"; return 1; }
    check_port_udp "$PORT" || { error "UDP 端口 ${PORT} 已被占用"; return 1; }

    read -rp "伪装域名（SNI）[默认 www.bing.com]: " SNI
    SNI=${SNI:-www.bing.com}


    HOP_RANGE=""
    read -rp "Enable UDP port hopping [y/N]: " HOP_ASK
    if [[ "$HOP_ASK" == "y" || "$HOP_ASK" == "Y" ]]; then
        HOP_START=$((RANDOM % 40000 + 10000))
        HOP_END=$((HOP_START + 999))
        # 跳端口范围不能撞主端口，也不能超出 65535
        if (( HOP_START <= PORT && PORT <= HOP_END )) || (( HOP_END > 65535 )); then
            HOP_START=$(( (PORT + 1000) % 40000 + 10000 ))
            (( HOP_START <= PORT && PORT <= HOP_START + 999 )) && HOP_START=$(( (PORT + 5000) % 40000 + 10000 ))
            HOP_END=$((HOP_START + 999))
        fi
        HOP_RANGE="${HOP_START}-${HOP_END}"
        info "Port-hop range ${HOP_START}-${HOP_END}"
    fi

    PASS=$(openssl rand -hex 16)
    [[ -n "$PASS" ]] || { error "密码生成失败"; return 1; }

    if ! command -v openssl >/dev/null 2>&1; then
        if [[ "$OS_TYPE" == "alpine" ]]; then apk add --no-cache openssl >/dev/null 2>&1; else apt-get install -y -qq openssl >/dev/null 2>&1; fi
    fi
    _gen_hy2_cert "$SNI" || return 1

    mkdir -p "$HY_DIR"
    local LISTEN_VALUE=":${PORT}"
    [[ -n "$HOP_RANGE" ]] && LISTEN_VALUE=":${PORT},${HOP_RANGE}"
    cat > "$HY_CONF" <<'EOF'
listen: :443
obfs:
  type: salamander
  salamander:
    password: OBFSPASS
ignoreClientBandwidth: false
congestion:
  type: bbr
auth:
  type: password
  password: AUTH_PASSWORD
masquerade:
  type: proxy
  proxy:
    url: https://news.ycombinator.com/
    rewriteHost: true

tls:
  cert: /etc/hysteria/server.crt
  key: /etc/hysteria/server.key
EOF
    sed -i "s|OBFSPASS|${PASS}|g" "$HY_CONF"
    sed -i "s|AUTH_PASSWORD|${PASS}|g" "$HY_CONF"
    sed -i "s|listen: :443|listen: ${LISTEN_VALUE}|g" "$HY_CONF"

    cat > "$META_HY2" <<EOF2
HY2_PORT=${PORT}
HY2_SNI=${SNI}
HY2_PASSWORD=${PASS}
HY2_PORT_RANGE=${HOP_RANGE}
HY2_CERT=${HY_CERT_F}
HY2_KEY=${HY_KEY_F}
EOF2
    chmod 600 "$META_HY2" "$HY_CONF"

    install_hysteria || return 1
    _setup_hy2_service || return 1
    _start_hy2_service || return 1
    info "HY2 BBR不限速 ${PORT} ${HOP_RANGE}"
    _print_hy2_link
}

remove_hy2() {
    has_hy2 || { error "Hysteria2 未启用"; return 1; }
    read -rp "确认移除 Hysteria2（停止并删除服务/配置/证书）？[y/N]: " C
    [[ "$C" != "y" && "$C" != "Y" ]] && warn "已取消" && return
    svc_ctrl "$HY_SERVICE" stop
    svc_ctrl "$HY_SERVICE" disable
    rm -f /etc/systemd/system/hysteria-server.service
    rm -f /etc/init.d/hysteria-server
    rm -rf "$HY_DIR"
    rm -f "$META_HY2"
    rm -f /var/log/hysteria-server.log /var/log/hysteria-server.err
    svc_reload_daemon
    info "Hysteria2 已移除（二进制保留；重装脚本会拉取最新版）"
}

hy2_share_link() {
    local SERVER=$1 PORT=$2 PASS=$3 SNI=$4 RANGE=${5:-}
    local HOST="$SERVER"
    [[ "$HOST" == *:* && "$HOST" != \[*\] ]] && HOST="[${HOST}]"
    local QUERY="sni=${SNI}&insecure=1&obfs=salamander&obfs-password=${PASS}"
    [[ -n "$RANGE" ]] && QUERY="${QUERY}&mport=${RANGE}"
    printf 'hy2://%s@%s:%s/?%s#Hysteria2-%s\n' "$PASS" "$HOST" "$PORT" "$QUERY" "$PORT"
}

_print_hy2_link() {
    has_hy2 || return 1
    local PORT PASS SNI SERVER_IP RANGE
    PORT=$(read_kv "$META_HY2" HY2_PORT); PASS=$(read_kv "$META_HY2" HY2_PASSWORD)
    SNI=$(read_kv "$META_HY2" HY2_SNI); SERVER_IP=$(get_public_ip); RANGE=$(read_kv "$META_HY2" HY2_PORT_RANGE)
    echo ""
    echo -e "${GREEN}===== Hysteria2 信息 =====${NC}"
    echo -e "地址   : ${SERVER_IP}"
    echo -e "端口   : ${PORT} (UDP)"
    echo -e "密码   : ${PASS}"
    echo -e "SNI    : ${SNI}"
    echo -e "证书   : 自签名，客户端需 insecure=1"
    echo -e "混淆   : Salamander（密码同值）"
    echo -e "Hop: ${RANGE:-none} (Clash ports)"
    echo -e "${CYAN}分享链接:${NC}"
    hy2_share_link "$SERVER_IP" "$PORT" "$PASS" "$SNI" "$RANGE"
    echo ""
}

show_hy2_link() {
    has_hy2 || { error "Hysteria2 尚未配置"; return 1; }
    _print_hy2_link
}

